# Smart Corridor pre-configuration of the Face Matcher Station member labels.
# Loaded after face-matcher/.env.station (see face-matcher.override.yml), so these pairs win.
# Keys and value formats: Smart Corridor watchlist member label set (integration docs).
# The face-matcher/ folder stays an unmodified copy of the Face Matcher release.

# Identity
WATCHLIST_MEMBER_KEY_0=firstName
WATCHLIST_MEMBER_LABEL_0=First Name
WATCHLIST_MEMBER_KEY_1=lastName
WATCHLIST_MEMBER_LABEL_1=Last Name
WATCHLIST_MEMBER_KEY_2=dob
WATCHLIST_MEMBER_LABEL_2=Date of Birth
WATCHLIST_MEMBER_KEY_3=sex
WATCHLIST_MEMBER_LABEL_3=Sex
WATCHLIST_MEMBER_KEY_4=country
WATCHLIST_MEMBER_LABEL_4=Nationality
WATCHLIST_MEMBER_KEY_5=placeOfBirth
WATCHLIST_MEMBER_LABEL_5=Place of Birth
# Travel document
WATCHLIST_MEMBER_KEY_6=doc
WATCHLIST_MEMBER_LABEL_6=Document
WATCHLIST_MEMBER_KEY_7=docType
WATCHLIST_MEMBER_LABEL_7=Document Type
WATCHLIST_MEMBER_KEY_8=docCountry
WATCHLIST_MEMBER_LABEL_8=Issuing Country
WATCHLIST_MEMBER_KEY_9=docIssued
WATCHLIST_MEMBER_LABEL_9=Issued
WATCHLIST_MEMBER_KEY_10=docExpiry
WATCHLIST_MEMBER_LABEL_10=Expires
# Journey
WATCHLIST_MEMBER_KEY_11=flight
WATCHLIST_MEMBER_LABEL_11=Flight
WATCHLIST_MEMBER_KEY_12=route
WATCHLIST_MEMBER_LABEL_12=Route
WATCHLIST_MEMBER_KEY_13=arrival
WATCHLIST_MEMBER_LABEL_13=Arrival
WATCHLIST_MEMBER_KEY_14=seat
WATCHLIST_MEMBER_LABEL_14=Seat
# Document images (stable URLs)
WATCHLIST_MEMBER_KEY_15=docFrontUrl
WATCHLIST_MEMBER_LABEL_15=Document Front (URL)
WATCHLIST_MEMBER_KEY_16=docBackUrl
WATCHLIST_MEMBER_LABEL_16=Document Back (URL)
